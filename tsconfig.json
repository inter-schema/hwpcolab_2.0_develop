{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./third_party/rhwp/rhwp-studio/src/*"],
      "@wasm/*": ["./resources/claw-hwp/scripts/vendor/rhwp/*"]
    }
  },
  "include": [
    "src",
    "third_party/rhwp/rhwp-studio/src/vite-env.d.ts"
  ]
}
